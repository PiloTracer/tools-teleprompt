# Copy to `.env.dev` or `.env.prd` (used by `./bin/start.sh dev|prd`).
# prd: only `.env.prd` is loaded (no fallback). `start.sh` forces project name
#      tools-teleprompt-prd if the file still has *-dev from a template copy.
# ── Stack identity ───────────────────────────────────────────────────────────
# Base product name + environment suffix isolate clones and label containers.
STACK_NAME=tools-teleprompt
STACK_ENV=dev
# Compose project (networks/volumes prefix). Default: ${STACK_NAME}-${context}
# For .env.prd prefer: STACK_ENV=prd  COMPOSE_PROJECT_NAME=tools-teleprompt-prd
COMPOSE_PROJECT_NAME=tools-teleprompt-dev

# ── Host-facing ports (9xxx dev range — avoids common 8080/5173 conflicts) ───
# Public HTTP entry (Caddy → API + frontend). Primary app URL.
PUBLIC_HOST=localhost
# Full SPA origin for QR / LAN handoff links. Shorter values = larger scripts fit in one QR (D14).
# Hotspot: set to your laptop IP + Vite port (direct HMR) or Caddy port (single entry).
#   PUBLIC_ORIGIN=http://10.42.0.1:9173   ← QR scans open Vite (typical hotspot dev)
#   PUBLIC_ORIGIN=http://10.42.0.1:9080   ← QR scans open Caddy (shorter path, same app)
PUBLIC_ORIGIN=
CADDY_HOST_PORT=9080
# Direct Vite dev server + HMR WebSocket (optional; bypass Caddy for frontend debugging)
FRONTEND_HOST_PORT=9173
# Container-internal ports (usually leave defaults)
FRONTEND_DEV_PORT=5173
API_DEV_PORT=8000

# ── API (API_* prefix applied by pydantic-settings where noted) ─────────────
API_MAX_SCRIPT_BYTES=262144
API_SESSION_TTL_SECONDS=300
API_RATE_LIMIT_CREATE=10
API_RATE_LIMIT_CLAIM=20
# Production: set a strong random secret (never commit real values)
API_OTP_HMAC_SECRET=change-me-before-production
REDIS_URL=redis://redis:6379/0
API_PUBLIC_BASE_URL=http://localhost:9080
# Hotspot/LAN: LAN handoff claim URLs use this base (Caddy port, not Vite).
#   API_PUBLIC_BASE_URL=http://10.42.0.1:9080

# ── Frontend build args (production image build) ─────────────────────────────
# Leave empty for same-origin API via Caddy proxy; set public URL if API is on another host
VITE_API_BASE_URL=
# Handoff QR URL origin (baked at build for production; dev compose passes from PUBLIC_* above).
# VITE_PUBLIC_ORIGIN=http://10.42.0.1:9173
# VITE_PUBLIC_HOST=10.42.0.1
# VITE_PUBLIC_PORT=9173
# Optional: force Vite HMR WebSocket to a host port (e.g. when debugging via FRONTEND_HOST_PORT)
# VITE_DEV_HMR_HOST=localhost
# VITE_DEV_HMR_PORT=9173
