# tools-teleprompt environment variables — keep lines aligned across .env.example .env .env.dev .env.prd
# Context: dev uses .env.dev (or .env); prd uses .env.prd only. Loaded by bin/start.sh → TP_ENV_FILE.
# ── Stack identity ──
# For prd, set STACK_ENV=prd and COMPOSE_PROJECT_NAME=tools-teleprompt-prd.
STACK_NAME=tools-teleprompt
STACK_ENV=dev
COMPOSE_PROJECT_NAME=tools-teleprompt-dev
# ── Host-facing ports ──
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=
CADDY_HOST_PORT=9080
FRONTEND_HOST_PORT=9173
FRONTEND_DEV_PORT=5173
API_DEV_PORT=8000
# ── API ──
API_MAX_SCRIPT_BYTES=262144
API_SESSION_TTL_SECONDS=300
API_RATE_LIMIT_CREATE=10
API_RATE_LIMIT_CLAIM=20
API_OTP_HMAC_SECRET=change-me-before-production
REDIS_URL=redis://redis:6379/0
API_PUBLIC_BASE_URL=http://localhost:9080
# Set to true to disable relay/LAN handoff and keep scripts client-side only (QR modes only).
DISABLE_SERVER_HANDOFF=false
# ── Frontend (Vite / handoff) ──
# For prd, VITE_API_BASE_URL is passed as a build arg to the static frontend image.
# Leave empty to let the browser use the same origin (Caddy serves API + frontend).
VITE_API_BASE_URL=
VITE_PUBLIC_ORIGIN=
VITE_PUBLIC_HOST=
VITE_PUBLIC_PORT=
VITE_DEV_HMR_HOST=
VITE_DEV_HMR_PORT=
# LAN/hotspot: set PUBLIC_HOST (e.g. 10.42.0.1). Optional HMR for direct Vite access (host:9173):
# VITE_DEV_HMR_HOST=10.42.0.1
# VITE_DEV_HMR_PORT=9173
# (client-facing only — vite.config.ts uses clientPort, not bind port, inside Docker)
